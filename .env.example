# ─────────────────────────────────────────────────────────────────────────────
# Grav Storage — environment template.
# Copy to `.env` and fill in. NEVER commit the real `.env` (it is git-ignored).
# ─────────────────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=4000

# Database — a SEPARATE local MongoDB, NOT the GRAV CMS / Atlas database.
MONGODB_URI=mongodb://localhost:27017/grav_storage

# Actual file bytes live OUTSIDE this repository. `objects/` go under this path;
# `tmp/` (in-flight uploads) and `trash/` are created as siblings automatically.
STORAGE_ROOT=D:\GravStorage\data

# Public self-service signup (the Cloudinary-style "Create Account" flow).
#   true  -> developers can register themselves
#   false -> signup closed; the super-admin creates users
ALLOW_SIGNUP=true

# ── First-run bootstrap super-admin ──────────────────────────────────────────
# Used ONCE, on first successful setup, to create the super-admin account.
# The password is hashed and stored; after setup these values are NOT used for
# normal authentication. Change the password after first login. Never commit.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ── Secrets (used from Phase 1 onward) ───────────────────────────────────────
# Session signing secret. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Optional server-side pepper mixed into API-key hashing (defense in depth).
KEY_HASH_PEPPER=

# Request-log retention in days (aggregated usage history is kept beyond this).
LOG_RETENTION_DAYS=30

# Storage backend selector (only "local" implemented in V1).
STORAGE_PROVIDER=local

# Max upload size in bytes (default 2 GiB). Set high — large files are expected.
MAX_UPLOAD_SIZE_BYTES=2147483648
# Hard cap on list page size.
MAX_LIST_LIMIT=100
# Set to 1 to expose Server-Timing / debug perf headers in production too.
# STORAGE_PERF_HEADERS=1

# ── Phase 4: production controls ──
# Trash + temp retention (used by maintenance scripts / admin actions).
TRASH_RETENTION_DAYS=30
TMP_MAX_AGE_HOURS=24
# Hard free-disk floor for new uploads (bytes). 0 disables the check.
MIN_FREE_DISK_BYTES=0
# Rate limiting (dev defaults are lenient; tighten in production).
API_RATE_LIMIT_REQUESTS=2000
API_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_REQUESTS=300
AUTH_RATE_LIMIT_WINDOW_MS=60000
# Concurrent transfer caps per project.
MAX_CONCURRENT_UPLOADS_PER_PROJECT=10
MAX_CONCURRENT_DOWNLOADS_PER_PROJECT=20

# ── Chunked / resumable uploads (all optional — defaults shown) ─────────────
# Bytes per chunk. Every chunk is ONE request, so it must stay below the public
# proxy's request-body cap (Cloudflare Free/Pro ≈ 100 MB). Clamped to 1–90 MiB.
# This is the API default and the maximum any client may ask for.
# CHUNK_SIZE_BYTES=83886080
# Chunk size the dashboard (browser) uploads with. Short requests survive an
# unreliable tunnel far better; clamped to 1 MiB–CHUNK_SIZE_BYTES.
# UPLOAD_BROWSER_CHUNK_BYTES=16777216
# Automatic attempts per chunk in the browser before it pauses for Retry (1–20).
# UPLOAD_RETRY_MAX_ATTEMPTS=6
# Read buffer for complete's from-disk verification. Clamped to 64 KiB–8 MiB.
# CHUNK_VERIFY_READ_BYTES=1048576
# An upload with no accepted chunk for this long expires. Until then it can be
# resumed, and it holds one upload slot and its temp file.
# CHUNK_SESSION_IDLE_TTL_MINUTES=360
# Maintenance deletes an UNREFERENCED chunk temp file only if older than this.
# CHUNK_ORPHAN_MIN_AGE_MINUTES=60
# A finalize that has been "completing" this long is treated as interrupted.
# CHUNK_COMPLETING_STALE_MINUTES=15
# Finished / aborted / expired session records are deleted after this (TTL index).
# CHUNK_SESSION_RETENTION_DAYS=7
# Set to 1 to log per-stage upload timings (diagnostics only — leave unset).
# UPLOAD_TIMING=
